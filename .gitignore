node_modules/
dist/
.DS_Store
*.log

# Derived image output. 2,890 WebP/AVIF files at ~185 MB: regenerated by
# script/optimize-assets.ts on every build and cached in CI, so committing it
# would only bloat the repository against GitHub's ~1 GB advisory limit.
public/images/carts/

# Raw originals. Kept outside the deployed output per Phase 6; only fetched
# when --keep-originals is passed, and never deployed.
assets-raw/carts/

# Route list written by the prerenderer for the verifier to read.
src/data/routes.json
assets-raw/reference-inventory.json

# Generated by script/generate-seo.ts on every build. Committing them would
# churn on every 6-hourly refresh and go stale against the deployed site.
public/sitemap.xml
public/sitemap-*.xml
public/robots.txt
public/llms.txt
public/inventory.json
public/guides.xml
public/manifest.webmanifest
public/CNAME
public/.nojekyll

# Generated by script/optimize-assets.ts from src/assets and public/icons.
public/images/*.svg
public/images/logo.png
public/images/og-image.webp

# Written by script/optimize-assets.ts alongside the derivatives.
src/data/image-manifest.json
